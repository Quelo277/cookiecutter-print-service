# ============================================================
# CookieCutterPrintService - Variables de Entorno
# ============================================================

# --- Servidor ---
HOST=0.0.0.0
PORT=8000

# --- Base de datos ---
DATABASE_PATH=./db/orders.db

# --- Precios y moneda ---
CURRENCY=ARS
CURRENCY_SYMBOL=$
COSTO_FILAMENTO_POR_CM3=0.5
COSTO_BASE=300.0
MARGEN=1.4

# --- SMTP (opcional - notificaciones por email) ---
# Dejar SMTP_HOST vacío para desactivar notificaciones por email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cookiecutter.local
SMTP_TO=admin@cookiecutter.local

# --- OpenSCAD / Pipeline ---
# Altura de la pared del cortante (mm)
WALL_HEIGHT=15
# Grosor de la pared del cortante (mm)
WALL_THICKNESS=1.2
# Altura del mango (mm)
HANDLE_HEIGHT=8
# Grosor del mango (mm)
HANDLE_THICKNESS=3
# Tamaño máximo de imagen permitido (MB)
MAX_IMAGE_SIZE_MB=10

# --- URLs ---
# URL pública de la aplicación (para enlaces en emails)
PUBLIC_URL=http://localhost:8000
